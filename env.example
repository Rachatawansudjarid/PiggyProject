# Get these two from your free Upstash Redis database (Storage tab in Upstash console,
# or Vercel > your project > Storage > Create Database > Upstash for Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The employee ID that unlocks the HR dashboard. Change this to something
# non-obvious before you deploy for real use.
HR_EMPLOYEE_ID=1111111
